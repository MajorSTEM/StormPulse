APP_NAME=StormPulse
# NWS requires a User-Agent identifying your app. Use: AppName/version contact@email.com
NWS_USER_AGENT=StormPulse/2.0 your@email.com
# NOAA API key (get one free at https://www.ncdc.noaa.gov/cdo-web/token)
NOAA_API_KEY=your_noaa_api_key_here
INGEST_INTERVAL_SECONDS=300
DATABASE_URL=sqlite+aiosqlite:///./stormpulse.db
# Add your deployed frontend URL once live, e.g. https://stormpulse-frontend.onrender.com
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]

# ── V2 hardened API layer ─────────────────────────────────────────────────────
# Client API keys as key:client_name pairs, comma-separated. The default ships
# a demo credential for the public map; issue real per-client keys in prod:
#   API_KEYS=<long-random-key>:nexalert,<another-key>:public-demo
API_KEYS=stormpulse-demo-key:public-demo
# Per-client rate limit (slowapi syntax)
RATE_LIMIT=120/minute
# Data older than this many seconds => stale:true + UI staleness banner
STALE_THRESHOLD_SECONDS=900
